{
  "schemaVersion": 1,
  "repository": "Murphisensei/openminis-bootstrap",
  "defaultRef": "main",
  "compatibility": {
    "openMinisVersion": ">=1.10"
  },
  "managedSkills": [
    "openminis-bootstrap",
    "openviking-memory"
  ],
  "mcpServers": [
    {
      "name": "openviking",
      "urlEnv": "OPENVIKING_MCP_URL",
      "tokenEnv": "OPENVIKING_MCP_TOKEN",
      "required": true
    }
  ]
}
