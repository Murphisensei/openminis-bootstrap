{
  "schemaVersion": 1,
  "repository": "Murphisensei/openminis-bootstrap",
  "defaultRef": "main",
  "compatibility": {
    "openMinisVersion": ">=1.10"
  },
  "managedSkills": [
    "openminis-bootstrap",
    "openviking-memory",
    "web-search",
    "meeting-transcription",
    "image-studio",
    "video-generation",
    "pdf-reader",
    "file-download",
    "openminis-agent"
  ],
  "profiles": {
    "freddy": {
      "assistant": "Taco",
      "soul": "profiles/freddy/SOUL.md",
      "agentSkill": "profiles/freddy/skills/openminis-agent"
    },
    "yurik": {
      "assistant": "Taco",
      "soul": "profiles/yurik/SOUL.md",
      "agentSkill": "profiles/yurik/skills/openminis-agent"
    }
  },
  "mcpServers": [
    {
      "name": "openviking",
      "skill": "openviking-memory",
      "urlEnv": "OPENVIKING_MCP_URL",
      "tokenEnv": "OPENVIKING_MCP_TOKEN",
      "required": true,
      "note": "Tailnet OpenViking durable memory; recall first, write only stable facts.",
      "requiredTools": [
        "memory_search",
        "memory_read",
        "memory_remember",
        "health"
      ]
    },
    {
      "name": "websearch",
      "skill": "web-search",
      "urlEnv": "WEBSEARCH_MCP_URL",
      "tokenEnv": "WEBSEARCH_MCP_TOKEN",
      "required": true,
      "note": "Tailnet current web, URL, X, research, Maps, and structured travel lookup.",
      "requiredTools": [
        "web_search",
        "read_url",
        "x_search",
        "vertical_search",
        "grounded_search",
        "travel_search",
        "provider_status",
        "health"
      ]
    },
    {
      "name": "meeting",
      "skill": "meeting-transcription",
      "urlEnv": "MEETING_MCP_URL",
      "tokenEnv": "MEETING_MCP_TOKEN",
      "required": false,
      "note": "Tailnet asynchronous meeting transcription; provider credentials stay on AWS KR.",
      "requiredTools": [
        "create_upload",
        "start_transcription",
        "job_status",
        "cancel_job",
        "health"
      ]
    },
    {
      "name": "image",
      "skill": "image-studio",
      "urlEnv": "IMAGE_MCP_URL",
      "tokenEnv": "IMAGE_MCP_TOKEN",
      "required": false,
      "note": "Tailnet asynchronous image generation and editing; results return to attachments.",
      "requiredTools": [
        "create_upload",
        "start_generation",
        "start_edit",
        "job_status",
        "cancel_job",
        "health"
      ]
    },
    {
      "name": "video",
      "skill": "video-generation",
      "urlEnv": "VIDEO_MCP_URL",
      "tokenEnv": "VIDEO_MCP_TOKEN",
      "required": false,
      "note": "Tailnet asynchronous short-video generation; paid settings require confirmation.",
      "requiredTools": [
        "create_audio_upload",
        "start_generation",
        "job_status",
        "cancel_job",
        "health"
      ]
    },
    {
      "name": "pdfreader",
      "skill": "pdf-reader",
      "urlEnv": "PDF_MCP_URL",
      "tokenEnv": "PDF_MCP_TOKEN",
      "required": false,
      "note": "Tailnet PDF extraction with local text parsing and OCR fallback.",
      "requiredTools": [
        "create_upload",
        "start_read",
        "job_status",
        "cancel_job",
        "health"
      ]
    },
    {
      "name": "download",
      "skill": "file-download",
      "urlEnv": "DOWNLOAD_MCP_URL",
      "tokenEnv": "DOWNLOAD_MCP_TOKEN",
      "required": false,
      "note": "Tailnet bounded public-file and media downloader with SSRF controls.",
      "requiredTools": [
        "start_download",
        "job_status",
        "cancel_job",
        "health"
      ]
    }
  ]
}
