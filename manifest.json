{
  "schemaVersion": 1,
  "repository": "Murphisensei/openminis-bootstrap",
  "defaultRef": "main",
  "compatibility": {
    "openMinisVersion": ">=1.10"
  },
  "managedSkills": [
    "openminis-bootstrap",
    "openviking-memory",
    "openminis-agent"
  ],
  "profiles": {
    "freddy": {
      "assistant": "Taco",
      "soul": "profiles/freddy/SOUL.md",
      "agentSkill": "profiles/freddy/skills/openminis-agent"
    },
    "yurik": {
      "assistant": "Taco",
      "soul": "profiles/yurik/SOUL.md",
      "agentSkill": "profiles/yurik/skills/openminis-agent"
    }
  },
  "mcpServers": [
    {
      "name": "openviking",
      "urlEnv": "OPENVIKING_MCP_URL",
      "tokenEnv": "OPENVIKING_MCP_TOKEN",
      "required": true
    }
  ]
}
