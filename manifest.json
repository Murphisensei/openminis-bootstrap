{
  "schemaVersion": 1,
  "repository": "Murphisensei/openminis-bootstrap",
  "defaultRef": "main",
  "compatibility": {
    "openMinisVersion": ">=1.10"
  },
  "managedSkills": [
    "openminis-bootstrap",
    "openviking-memory",
    "web-search",
    "openminis-agent"
  ],
  "profiles": {
    "freddy": {
      "assistant": "Taco",
      "soul": "profiles/freddy/SOUL.md",
      "agentSkill": "profiles/freddy/skills/openminis-agent"
    },
    "yurik": {
      "assistant": "Taco",
      "soul": "profiles/yurik/SOUL.md",
      "agentSkill": "profiles/yurik/skills/openminis-agent"
    }
  },
  "mcpServers": [
    {
      "name": "openviking",
      "skill": "openviking-memory",
      "urlEnv": "OPENVIKING_MCP_URL",
      "tokenEnv": "OPENVIKING_MCP_TOKEN",
      "required": true,
      "note": "Tailnet OpenViking durable memory; recall first, write only stable facts.",
      "requiredTools": [
        "memory_search",
        "memory_read",
        "memory_remember",
        "health"
      ]
    },
    {
      "name": "websearch",
      "skill": "web-search",
      "urlEnv": "WEBSEARCH_MCP_URL",
      "tokenEnv": "WEBSEARCH_MCP_TOKEN",
      "required": true,
      "note": "Tailnet current web, URL, X, Scholar, patents, trends, and Maps search.",
      "requiredTools": [
        "web_search",
        "read_url",
        "x_search",
        "vertical_search",
        "grounded_search",
        "provider_status",
        "health"
      ]
    }
  ]
}
